<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Stown" parent="Theme.Material3.DayNight.NoActionBar" />

    <!-- Share popup: floating dialog with a clear rounded surface and sane width.
         Without an explicit windowBackground the Material3 dialog theme renders
         a washed-out / distorted popup on some devices. -->
    <style name="Theme.Stown.Dialog" parent="Theme.Material3.DayNight.Dialog">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowMinWidthMajor">90%</item>
        <item name="android:windowMinWidthMinor">90%</item>
        <item name="android:windowCloseOnTouchOutside">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.5</item>
    </style>

</resources>
